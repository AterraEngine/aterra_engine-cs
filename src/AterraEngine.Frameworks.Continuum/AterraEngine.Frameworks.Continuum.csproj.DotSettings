        x:Key="/Default/CodeInspection/NamespaceProvider/NamespaceFoldersToSkip/=ContinuumServicefactory/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean
        x:Key="/Default/CodeInspection/NamespaceProvider/NamespaceFoldersToSkip/=ContinuumServicefactorybuilders/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean
        x:Key="/Default/CodeInspection/NamespaceProvider/NamespaceFoldersToSkip/=queries/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/CodeInspection/NamespaceProvider/NamespaceFoldersToSkip/=triggers/@EntryIndexedValue">True</s:Boolean></wpf:ResourceDictionary>